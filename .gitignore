.DS_Store
.cache/

# Explicitly ignore Talos config files
talos/controlplane.yaml
talos/talosconfig
talos/worker.yaml

# Terraform files
terraform/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfplan
terraform/**/*.tfvars
terraform/backend.tf

# Local security and backup material
.secrets/
.backups/
*.restic-password
*.pem
*.key

# UniFi / GPON recovery material contains device identities or credentials.
# Keep private LEOX parameter exports and UniFi backups outside Git.
infra/unifi/backups/
infra/unifi/private/
infra/unifi/**/*leox*backup*
infra/unifi/**/*gpon*backup*
infra/unifi/**/*ucg*backup*
infra/unifi/**/*.unf

# Helm dependency archives are regenerated from tracked lock files
**/charts/
