.DS_Store
.cache/

# Explicitly ignore Talos config files
talos/controlplane.yaml
talos/talosconfig
talos/worker.yaml

# Terraform files
terraform/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfplan
terraform/**/*.tfvars
terraform/backend.tf

# Local security and backup material
.secrets/
.backups/
*.restic-password
*.pem
*.key

# Helm dependency archives are regenerated from tracked lock files
**/charts/
