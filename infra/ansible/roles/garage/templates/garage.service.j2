[Unit]
Description=Garage S3 state store
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/terraform
ConditionPathIsMountPoint=/srv/terraform

[Service]
Type=simple
User=garage-svc
Group=garage-svc
Environment=GARAGE_CONFIG_FILE=/etc/garage.toml
EnvironmentFile=/srv/terraform/garage/s3-bootstrap.env
ExecStart=/usr/local/bin/garage server --single-node --default-bucket
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/terraform/garage
LimitNOFILE=42000

[Install]
WantedBy=multi-user.target
