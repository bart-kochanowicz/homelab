[Unit]
Description=Restore applications after interrupted homelab backups
Wants=network-online.target
After=network-online.target
Before=homelab-backup.service homelab-backup.timer
RequiresMountsFor=/srv/terraform
ConditionPathIsMountPoint=/srv/terraform
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=backup-svc
Group=backup-svc
EnvironmentFile=/etc/homelab-backup/environment
ExecStartPre=/usr/bin/mountpoint --quiet /srv/terraform
ExecStart=/usr/bin/timeout 120 /usr/local/libexec/homelab-backup --recover
TimeoutStartSec=130
Restart=on-failure
RestartSec=30
UMask=0077
MemoryMax=512M
CPUQuota=100%
IOWeight=20
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/terraform/backups
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.0.70.11/32

[Install]
WantedBy=multi-user.target
