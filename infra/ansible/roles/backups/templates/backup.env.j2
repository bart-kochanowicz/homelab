PATH=/usr/local/bin:/usr/bin:/bin
HOME=/srv/terraform/backups
TMPDIR=/srv/terraform/backups/tmp
RESTIC_REPOSITORY=/srv/terraform/backups/homelab-restic
RESTIC_PASSWORD_FILE=/etc/homelab-backup/restic-password
RESTIC_CACHE_DIR=/srv/terraform/backups/cache
KUBECONFIG=/etc/homelab-backup/kubeconfig
BACKUP_STATE_DIR=/srv/terraform/backups/state
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
BACKUP_PRUNE_ENABLED={{ '1' if houston_backup_prune_enabled | bool else '0' }}
GOMAXPROCS=2
