[Unit]
Description=Encrypted backups of homelab application volumes
Wants=network-online.target
Requires=homelab-backup-recovery.service
After=network-online.target homelab-backup-recovery.service
OnFailure=homelab-backup-recovery.service
RequiresMountsFor=/srv/terraform
ConditionPathIsMountPoint=/srv/terraform

[Service]
Type=oneshot
User=backup-svc
Group=backup-svc
EnvironmentFile=/etc/homelab-backup/environment
ExecStartPre=/usr/bin/mountpoint --quiet /srv/terraform
ExecStart=/usr/local/libexec/homelab-backup --run
ExecStartPost=/usr/local/libexec/homelab-backup --maintenance
ExecStopPost=/usr/bin/timeout 120 /usr/local/libexec/homelab-backup --recover
TimeoutStartSec=20min
TimeoutStopSec=130
KillMode=control-group
UMask=0077
MemoryMax=512M
CPUQuota=100%
IOWeight=20
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/terraform/backups
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=10.0.70.11/32
