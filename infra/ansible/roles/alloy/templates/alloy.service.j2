[Unit]
Description=Private host journal collector
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/terraform
ConditionPathIsMountPoint=/srv/terraform

[Service]
Type=simple
User=alloy
Group=alloy
ExecStart=/usr/local/bin/alloy run --disable-reporting --storage.path=/srv/terraform/alloy --server.http.listen-addr=10.0.70.10:12345 /etc/alloy/config.alloy
Restart=on-failure
RestartSec=10
UMask=0077
MemoryMax=256M
CPUQuota=50%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/terraform/alloy
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
IPAddressAllow=10.0.70.10/32
IPAddressAllow=10.0.70.11/32
IPAddressAllow=10.0.70.12/32

[Install]
WantedBy=multi-user.target
